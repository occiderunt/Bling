# Copy to keystore.properties (gitignored) and fill in to sign release APKs.
# Any of these can also come from env vars instead:
# BLING_KEYSTORE, BLING_KEYSTORE_PASSWORD, BLING_KEY_ALIAS, BLING_KEY_PASSWORD
storeFile=/absolute/path/to/release.jks
storePassword=change-me
keyAlias=release
keyPassword=change-me
